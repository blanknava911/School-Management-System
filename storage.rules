rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Files use schools/<schoolId>/... paths and are served by the authenticated
    // Express API. Direct client access stays disabled; Firebase Admin performs
    // tenant and role checks before reading or writing an object.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
