rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
      );
    }
    
    function belongsToSchool(schoolId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.schoolId == schoolId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId
      );
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.token.role == 'SCHOOL_ADMIN' && request.auth.token.schoolId == schoolId);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || belongsToSchool(resource.data.schoolId));
      allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId) || (isAuthenticated() && belongsToSchool(request.resource.data.schoolId));
    }

    match /assessments/{assessmentId} {
      allow read, write: if isAuthenticated() && belongsToSchool(resource.data.schoolId);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.schoolId);
    }

    match /knowledgeHub/{resourceId} {
      allow read, write: if isAuthenticated() && belongsToSchool(resource.data.schoolId);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.schoolId);
    }

    match /students/{studentId} {
      allow read, write: if isAuthenticated() && belongsToSchool(resource.data.schoolId);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.schoolId);
    }

    match /studentMarks/{markId} {
      allow read, write: if isAuthenticated() && belongsToSchool(resource.data.schoolId);
      allow create: if isAuthenticated() && belongsToSchool(request.resource.data.schoolId);
    }

    match /auditTrail/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
